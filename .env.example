# Supabase — projet créé sur https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Clé service_role — NE JAMAIS exposer côté client, utilisée uniquement
# dans les routes API (app/api/**) pour écrire les leads et lire le dashboard admin.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publique du site (utilisée pour les redirections d'auth admin)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
